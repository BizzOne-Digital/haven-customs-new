# ── Database (required) ─────────────────────────────────────────
# MongoDB Atlas connection string. Include the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/haven-customs?retryWrites=true&w=majority

# ── Site ────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://havencustoms.ca

# ── Initial admin (used only by `npm run create-admin`) ─────────
# Set these, run the script once, then remove ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── GHL booking calendar (public widget URLs, not secrets) ──────
# Default calendar used by every "Book Appointment" button.
# Example: https://api.leadconnectorhq.com/widget/booking/XXXXXXXXXXXX
# Optional: defaults to the Haven "Service booking" calendar (nHnHjnp24SvMsZmSECZ2) when blank.
GHL_BOOKING_WIDGET_URL=https://api.leadconnectorhq.com/widget/booking/nHnHjnp24SvMsZmSECZ2
# Optional per-service calendars, keyed by Product.calendarKey (JSON).
# Seeded keys: "mon-thu" (ceramic coating + head/tail light tint).
# Example: {"mon-thu":"https://api.leadconnectorhq.com/widget/booking/YYYYYYYY"}
GHL_CALENDAR_MAP=

# ── GHL inquiries (server-only secrets) ─────────────────────────
# Option A (preferred): Private Integration token + Location ID → contacts upsert with tags + note.
GHL_API_KEY=
GHL_LOCATION_ID=
# Option B: an inbound webhook URL from a GHL workflow (used only if Option A is blank).
GHL_INQUIRY_WEBHOOK_URL=

# ── Meta Conversions API (optional, server-only) ────────────────
META_PIXEL_ID=
META_CONVERSION_API_TOKEN=
